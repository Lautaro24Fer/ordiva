# Copiar a .env y ajustar. Nunca commitear .env.

# Runtime (Prisma Client + adapter pg). En Neon: URL con pooler.
DATABASE_URL=postgresql://booking:booking@localhost:5433/booking?schema=public
# CLI de Prisma (migraciones). En Neon: URL directa, sin pooler.
DIRECT_URL=postgresql://booking:booking@localhost:5433/booking?schema=public
# Base exclusiva para tests de integración (se trunca entre tests).
DATABASE_URL_TEST=postgresql://booking:booking@localhost:5433/booking_test?schema=public

# Auth.js: firma y cifra la cookie de sesión. Generar con: openssl rand -base64 33
AUTH_SECRET=replace-with-long-cryptographically-random-secret
# Fuera de Vercel con `npm run build && npm start` o Docker (en `next dev` no hace falta):
# AUTH_URL=http://localhost:3000
# Detrás de un proxy (Docker Compose ya lo define): confiar en el header Host.
# AUTH_TRUST_HOST=true

# Docker Compose (perfil `full`): contraseña de PostgreSQL y seed en el primer arranque.
# POSTGRES_PASSWORD=booking
# SEED=1

# Demo sin base de datos (datos en el localStorage de cada visitante). Se fija
# en el build; en ese modo no hacen falta DATABASE_URL ni DIRECT_URL.
# NEXT_PUBLIC_DEMO_MODE=1
